# Copy this file to .env and fill in real values. Never commit .env.

# Port the API listens on (Render injects its own PORT automatically)
PORT=3000
NODE_ENV=development

# MongoDB Atlas connection string (free M0 cluster)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/movie-watchlist?retryWrites=true&w=majority

# TMDB credentials — server-side only, never exposed to the browser.
# The Read Access Token (Bearer) is preferred; the API key is used as a fallback.
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=

# Allowed frontend origin(s) for CORS, comma-separated (localhost is always allowed)
CLIENT_URL=https://your-app.vercel.app
